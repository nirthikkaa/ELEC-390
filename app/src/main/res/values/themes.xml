<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.ThereminGlovestest2" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>

        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>

        <item name="colorTertiary">@color/app_tertiary</item>
        <item name="colorOnTertiary">@color/app_on_tertiary</item>

        <item name="android:colorBackground">@color/app_background</item>

        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>

        <item name="colorOutline">@color/app_outline</item>
        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_on_surface_variant</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ThereminGlovestest2" parent="Base.Theme.ThereminGlovestest2" />

    <!--
        BeatMaker uses the same deep-purple window background as the swipe preview overlay
        (0xFF0F0A1E) so the Activity window never flashes white during the slide-in transition.
        Without this the system draws the default window color for one frame before the layout
        inflates, causing a visible flash.
    -->
    <style name="Theme.BeatMaker" parent="Theme.ThereminGlovestest2">
        <item name="android:windowBackground">#0F0A1E</item>
    </style>
</resources>