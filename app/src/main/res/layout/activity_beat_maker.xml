<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B1A"
    android:orientation="vertical">

    <com.example.thereminglovestest2.TopNavBarView
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Slot selector — fixed above the grid so it's always reachable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0B0B1A"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <!-- Row 1: slots 1-4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="BEAT 1"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 2"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 3"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot4"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 4"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

        <!-- Row 2: slots 5-8 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot5"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="BEAT 5"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot6"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 6"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot7"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 7"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSlot8"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="BEAT 8"
                android:textSize="9sp"
                android:textColor="#555777"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="4dp"
                app:strokeColor="#333355"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A30" />

    <com.example.thereminglovestest2.InsetAwareScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Transport: Play/Stop, BPM, Clear -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#0F0F22"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A2A1A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayStop"
                            android:layout_width="64dp"
                            android:layout_height="36dp"
                            android:text="PLAY"
                            android:textColor="#00FF9D"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            app:strokeColor="#00FF9D"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="BPM"
                            android:textColor="#666888"
                            android:textSize="9sp"
                            android:fontFamily="monospace" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBpmMinus"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="6dp"
                            android:text="−"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            app:strokeColor="#00E5FF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <SeekBar
                            android:id="@+id/sbBeatMakerBpm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:max="140"
                            android:progress="60"
                            android:progressTint="#00E5FF"
                            android:thumbTint="#00E5FF"
                            android:thumb="@drawable/slider_thumb_rect" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBpmPlus"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="4dp"
                            android:text="+"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            app:strokeColor="#00E5FF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <TextView
                            android:id="@+id/tvBeatMakerBpm"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="120"
                            android:gravity="end"
                            android:textColor="#00E5FF"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="CLEAR"
                            android:textColor="#FF6666"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            app:strokeColor="#FF6666"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap label to preview · Drag across a row to fill steps"
                        android:textColor="#555777"
                        android:textSize="10sp"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step grid — single custom Canvas view, all 9×16 in one surface -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#0B0B1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A2A1A"
                app:strokeWidth="1dp">

                <com.example.thereminglovestest2.StepGridView
                    android:id="@+id/stepGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#0F0F22"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A2A3A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="8dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="#7EB8FF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="KEYS"
                            android:textColor="#7EB8FF"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.2"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBeatMakerKeyNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="tap a key"
                            android:textColor="#888AAA"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBeatMakerKeyMode"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:text="NOTE"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            app:strokeColor="#7EB8FF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBeatMakerSynth"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="KEYS"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:fontFamily="monospace"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            app:strokeColor="#00CCFF"
                            app:strokeWidth="1dp"
                            app:cornerRadius="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E1E30" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:text="Tap a key to write the current step while playing. Tap a note cell to select or tap it again to clear."
                        android:textColor="#556677"
                        android:textSize="9sp"
                        android:fontFamily="monospace" />

                    <com.example.thereminglovestest2.PianoStepStripView
                        android:id="@+id/beatMakerPianoSteps"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="6dp" />

                    <com.example.thereminglovestest2.PianoKeyboardView
                        android:id="@+id/beatMakerKeyboard"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Apply -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0F0F22"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A2A1A"
                app:strokeWidth="1dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApply"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_margin="12dp"
                    android:text="APPLY TO PLAY SCREEN"
                    android:textColor="#0B0B1A"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#00FF9D"
                    app:cornerRadius="8dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.example.thereminglovestest2.InsetAwareScrollView>

</LinearLayout>
