<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:id="@+id/launchLoadingChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/launchLoadingIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            app:indicatorColor="@color/launch_cyan"
            app:indicatorInset="0dp"
            app:indicatorSize="40dp"
            app:trackColor="#1FFFFFFF"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvLaunchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading Play"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLaunchDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Preparing audio, Bluetooth, and saved settings..."
            android:textColor="@color/launch_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
