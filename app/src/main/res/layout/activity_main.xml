<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.example.thereminglovestest2.TopNavBarView
        android:id="@+id/topNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.example.thereminglovestest2.InsetAwareScrollView
        android:id="@+id/rootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlayHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            android:text="Looking for gloves"
                            android:textColor="@color/app_on_surface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnPerformanceMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stage View"
                            android:textSize="11sp"
                            android:minWidth="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            style="?attr/borderlessButtonStyle" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAudio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        android:text="Turn on both gloves to begin playing."
                        android:textColor="@color/app_on_surface_variant"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardVolChip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/app_surface_variant"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/app_outline"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:id="@+id/tvVolLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Volume Glove"
                                    android:textColor="@color/app_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvVolValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:minHeight="36dp"
                                    android:gravity="center_vertical"
                                    android:text="Waiting"
                                    android:textColor="@color/app_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardPitchChip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/app_surface_variant"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/app_outline"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:id="@+id/tvPitchLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pitch Glove"
                                    android:textColor="@color/app_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPitchValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:minHeight="36dp"
                                    android:gravity="center_vertical"
                                    android:text="Waiting"
                                    android:textColor="@color/app_on_surface"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.example.thereminglovestest2.ThereminVisualizerView
                        android:id="@+id/thereminVisualizerView"
                        android:layout_width="386dp"
                        android:layout_height="307dp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvToneValue"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:text="hidden" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp">

                <!-- Three-button row: Record | Play | Tone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="14dp">

                    <!-- Record column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="76dp"
                            android:layout_height="76dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_record_button_halo" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRecord"
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:layout_gravity="center"
                                android:contentDescription="Record performance"
                                android:elevation="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text=""
                                app:backgroundTint="#B8222D"
                                app:cornerRadius="34dp"
                                app:icon="@drawable/ic_record"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/white"
                                app:rippleColor="#99FF8A8A"
                                app:strokeColor="#FFF2A7A7"
                                app:strokeWidth="2dp" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvRecordLabel"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="Record"
                            android:textColor="#FFD3D8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRecordingTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/recording_timer_zero"
                            android:textColor="#FFF2A7A7"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Play column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="106dp"
                            android:layout_height="106dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_play_button_halo" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAudioStart"
                                android:layout_width="94dp"
                                android:layout_height="94dp"
                                android:layout_gravity="center"
                                android:contentDescription="Play or pause tone"
                                android:elevation="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text=""
                                app:backgroundTint="@color/app_primary"
                                app:cornerRadius="47dp"
                                app:icon="@drawable/ic_play_theremin"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="36dp"
                                app:iconTint="@color/app_on_primary"
                                app:rippleColor="#99E9F4FF"
                                app:strokeColor="#FFE4F2FF"
                                app:strokeWidth="2dp" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvPlayRemoteLabel"
                            android:layout_width="94dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="Play"
                            android:textColor="#FFEAF3FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Tone column: detented knob -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <com.example.thereminglovestest2.ToneKnobView
                            android:id="@+id/toneKnob"
                            android:layout_width="108dp"
                            android:layout_height="108dp" />

                        <TextView
                            android:id="@+id/tvToneLabel"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Sine"
                            android:textColor="@color/app_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Invisible placeholder — referenced by MainActivity binding -->
                    <Button
                        android:id="@+id/btnDisconnectAll"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:text="Disconnect All"
                        android:visibility="gone" />

                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>

            <!-- Sprint 3: Scale + Octave + Drum compact card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Row 1: Scale chips (horizontal scroll so full names fit) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupScale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:chipSpacingHorizontal="4dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipChromatic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chromatic"
                                android:checked="true"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMajor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Major"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMinor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minor"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPentatonic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pentatonic"
                                style="@style/Widget.Material3.Chip.Filter" />

                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Row 2: Drum toggle (left) + Octave shift (right) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDrumToggle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Drums Off"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBassToggle"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Bass Off"
                            android:textSize="12sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOctaveDown"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="−"
                            android:textSize="16sp"
                            android:contentDescription="Octave down"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <TextView
                            android:id="@+id/tvOctaveLabel"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Oct +0"
                            android:textSize="12sp"
                            android:textColor="@color/app_on_surface"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOctaveUp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="16sp"
                            android:contentDescription="Octave up"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sprint 3: Effects card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEffects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <!-- Reverb row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReverb"
                                android:layout_width="90dp"
                                android:layout_height="32dp"
                                android:text="Reverb"
                                android:textSize="12sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                            <SeekBar
                                android:id="@+id/sbReverbMix"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:max="100"
                                android:progress="30" />

                            <TextView
                                android:id="@+id/tvReverbVal"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:gravity="end"
                                android:text="30%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <View android:layout_width="90dp" android:layout_height="0dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="0%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="42dp"
                                android:text="100%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Delay row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDelay"
                                android:layout_width="90dp"
                                android:layout_height="32dp"
                                android:text="Delay"
                                android:textSize="12sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                            <SeekBar
                                android:id="@+id/sbDelayFeedback"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:max="90"
                                android:progress="35" />

                            <TextView
                                android:id="@+id/tvDelayVal"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:gravity="end"
                                android:text="39%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <View android:layout_width="90dp" android:layout_height="0dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="0%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="42dp"
                                android:text="90%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Distortion row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDistortion"
                                android:layout_width="90dp"
                                android:layout_height="32dp"
                                android:text="Distort"
                                android:textSize="12sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />

                            <SeekBar
                                android:id="@+id/sbDistortionGain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:max="100"
                                android:progress="20" />

                            <TextView
                                android:id="@+id/tvDistortionVal"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:gravity="end"
                                android:text="20%"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <View android:layout_width="90dp" android:layout_height="0dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="1×"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="42dp"
                                android:text="10×"
                                android:textColor="@color/app_on_surface_variant"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Debug Log"
                        android:textColor="@color/app_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="(log)"
                        android:textColor="@color/app_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.example.thereminglovestest2.InsetAwareScrollView>

    <com.example.thereminglovestest2.BottomNavBarView
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
